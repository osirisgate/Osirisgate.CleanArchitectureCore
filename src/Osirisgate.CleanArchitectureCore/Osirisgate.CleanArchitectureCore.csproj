<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>Osirisgate.CleanArchitectureCore</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackageId>Osirisgate.CleanArchitectureCore</PackageId>
        <PackageDescription>Osirisgate Clean Architecture Core is a .NET library designed to provide a solid foundation for implementing Clean Architecture. It offers a structured, testable, and maintainable way to handle application logic by separating requests, business rules, and responses.</PackageDescription>
        <Version>1.0.0</Version>
        <Authors>Ulrich Geraud A.</Authors>
        <Company>Osirisgate</Company>
        <ProjectUrl>https://github.com/osirisgate/Osirisgate.CleanArchitectureCore</ProjectUrl>
        <RepositoryUrl>https://github.com/osirisgate/Osirisgate.CleanArchitectureCore.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <IncludePackageReferencesInPackage>true</IncludePackageReferencesInPackage>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    </ItemGroup>

</Project>
